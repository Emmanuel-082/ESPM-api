    {
      "name": "3. PQR",
      "item": [
        {
          "name": "3.1 Radicar PQR (exitoso)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/pqr",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "pqr"
              ]
            },
            "description": "Radica un reclamo y guarda el número de radicado en la variable radicado. Respuesta esperada: 201.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"tipo\": \"Reclamo\",\n  \"servicio\": \"Facturación\",\n  \"nombre\": \"Juan Pérez\",\n  \"cedula\": \"1234567890\",\n  \"telefono\": \"3101234567\",\n  \"correo\": \"juan@ejemplo.com\",\n  \"cuenta\": \"001-2345-6\",\n  \"descripcion\": \"Me cobraron dos veces el servicio de aseo.\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"El código de respuesta es 201\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "pm.test(\"La respuesta indica ok = true\", function () {",
                  "    pm.expect(pm.response.json().ok).to.eql(true);",
                  "});",
                  "pm.test(\"Devuelve el número de radicado y lo guarda\", function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.datos.radicado).to.include(\"PQR-\");",
                  "    pm.collectionVariables.set(\"radicado\", json.datos.radicado);",
                  "});"
                ]
              }
            }
          ]
