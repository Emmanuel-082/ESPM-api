{
  "info": {
    "name": "API ESPM – Pruebas (AA5-EV04)",
    "description": "Pruebas de la API REST de ESPM Moniquirá. Antes de ejecutar: iniciar el servidor (node server.js) con la base de datos limpia (borrar data/db.json). Ejecutar las peticiones en orden.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "0. Estado de la API",
      "item": [
        {
          "name": "0.1 Comprobar que la API está activa",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/salud",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "salud"
              ]
            },
            "description": "Verifica que el servidor está encendido."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"El código de respuesta es 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"La respuesta indica ok = true\", function () {",
                  "    pm.expect(pm.response.json().ok).to.eql(true);",
                  "});",
                  "pm.test(\"El mensaje confirma que la API funciona\", function () {",
                  "    pm.expect(pm.response.json().mensaje).to.include(\"funcionando\");",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "1. Cuentas de usuario",
      "item": [
        {
          "name": "1.1 Registrar usuario (exitoso)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/registro",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "registro"
              ]
            },
            "description": "Crea la cuenta del usuario de pruebas. Respuesta esperada: 201.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Juan Pérez\",\n  \"cedula\": \"1234567890\",\n  \"telefono\": \"3101234567\",\n  \"correo\": \"juan@ejemplo.com\",\n  \"contrasena\": \"Clave12345\",\n  \"confirmarContrasena\": \"Clave12345\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"El código de respuesta es 201\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "pm.test(\"La respuesta indica ok = true\", function () {",
                  "    pm.expect(pm.response.json().ok).to.eql(true);",
                  "});",
                  "pm.test(\"No devuelve la contraseña\", function () {",
                  "    pm.expect(pm.response.json().datos).to.not.have.property(\"contrasena\");",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "1.2 Registrar usuario (correo repetido)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/registro",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "registro"
              ]
            },
            "description": "Intenta registrar el mismo correo otra vez. Respuesta esperada: 409.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Juan Pérez\",\n  \"cedula\": \"1234567890\",\n  \"telefono\": \"3101234567\",\n  \"correo\": \"juan@ejemplo.com\",\n  \"contrasena\": \"Clave12345\",\n  \"confirmarContrasena\": \"Clave12345\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"El código de respuesta es 409\", function () {",
                  "    pm.response.to.have.status(409);",
                  "});",
                  "pm.test(\"La respuesta indica ok = false\", function () {",
                  "    pm.expect(pm.response.json().ok).to.eql(false);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "1.3 Registrar usuario (datos inválidos)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/registro",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "registro"
              ]
            },
            "description": "Envía datos incorrectos. Respuesta esperada: 400 con la lista de errores.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"J\",\n  \"cedula\": \"abc\",\n  \"telefono\": \"123\",\n  \"correo\": \"no-es-correo\",\n  \"contrasena\": \"123\",\n  \"confirmarContrasena\": \"456\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"El código de respuesta es 400\", function () {",
                  "    pm.response.to.have.status(400);",
                  "});",
                  "pm.test(\"La respuesta indica ok = false\", function () {",
                  "    pm.expect(pm.response.json().ok).to.eql(false);",
                  "});",
                  "pm.test(\"Lista varios errores de validación\", function () {",
                  "    pm.expect(pm.response.json().detalles.length >= 5).to.eql(true);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "1.4 Iniciar sesión (usuario)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "description": "Inicia sesión y guarda el token en la variable tokenUsuario. Respuesta esperada: 200.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"correo\": \"juan@ejemplo.com\",\n  \"contrasena\": \"Clave12345\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"El código de respuesta es 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"La respuesta indica ok = true\", function () {",
                  "    pm.expect(pm.response.json().ok).to.eql(true);",
                  "});",
                  "pm.test(\"Devuelve un token y lo guarda\", function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.datos.token).to.be.a(\"string\");",
                  "    pm.collectionVariables.set(\"tokenUsuario\", json.datos.token);",
                  "});"
                ]
              }
            }
          ]
        },
