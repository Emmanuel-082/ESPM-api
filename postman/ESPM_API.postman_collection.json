        {
          "name": "1.6 Iniciar sesión (administrador)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "description": "Inicia sesión como administrador y guarda el token en tokenAdmin.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"correo\": \"admin@espm.gov.co\",\n  \"contrasena\": \"Admin12345\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"El código de respuesta es 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"La respuesta indica ok = true\", function () {",
                  "    pm.expect(pm.response.json().ok).to.eql(true);",
                  "});",
                  "pm.test(\"El rol es admin y guarda el token\", function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.datos.usuario.rol).to.eql(\"admin\");",
                  "    pm.collectionVariables.set(\"tokenAdmin\", json.datos.token);",
                  "});"
                ]
              }
            }
          ]
        },
